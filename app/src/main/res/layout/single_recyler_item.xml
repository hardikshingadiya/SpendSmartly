<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="7dp"
    android:paddingTop="3dp"
    android:background="#FFFFFF">

    <!-- First Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:paddingHorizontal="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rcv_amount"
            android:layout_width="0dp"
            android:layout_weight="2.8"
            android:layout_height="wrap_content"
            android:text="Record Amount"
            android:textColor="#F88B08"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/rcv_type"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content"
            android:text="Record Type"
            android:paddingHorizontal="3dp"
            android:textColor="#0072BB"
            android:textSize="16sp"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/recordEditBtn"
            android:layout_width="0dp"
            android:layout_weight="0.5"
            android:layout_height="17dp"
            android:foreground="@drawable/edit2"
            android:layout_marginRight="-13dp"
            android:foregroundGravity="center"
            android:foregroundTint="@color/blue"
            android:gravity="center"
            android:text="" />
    </LinearLayout>

    <!-- Second Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:paddingHorizontal="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rcv_cat"
            android:layout_width="0dp"
            android:layout_weight="3.8"
            android:layout_height="wrap_content"
            android:text="Record Category"
            android:textColor="#0072BB"
            android:textSize="12.5sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/rcv_date"
            android:layout_width="0dp"
            android:layout_weight="2.5"
            android:layout_height="wrap_content"
            android:paddingHorizontal="3dp"
            android:text="Record Date"
            android:textColor="@color/gray"
            android:textStyle="italic|bold"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Third Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rcv_desc"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="match_parent"
            android:paddingLeft="10dp"
            android:paddingRight="7dp"
            android:paddingVertical="3dp"
            android:text="Record Description"
            android:maxLines="2"
            android:lines="2"
            android:textColor="@color/gray"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/rcv_time"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content"
            android:paddingHorizontal="3dp"
            android:text="Record Time"
            android:layout_marginTop="1dp"
            android:textColor="@color/gray"
            android:textSize="12.5sp"
            android:textStyle="italic"/>

        <TextView
            android:id="@+id/recordDeleteBtn"
            android:layout_width="0dp"
            android:layout_weight="0.5"
            android:layout_height="15dp"
            android:layout_marginVertical="10dp"
            android:foreground="@drawable/delete_fill"
            android:foregroundGravity="center"
            android:foregroundTint="@color/blue"
            android:gravity="center"
            android:text="" />
    </LinearLayout>

</LinearLayout>
