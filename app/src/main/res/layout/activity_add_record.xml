<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Add_Record"
    android:background="@color/main_bg"
    android:layout_gravity="start">


    <androidx.cardview.widget.CardView
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="580dp"
        android:layout_margin="20dp"
        android:padding="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/linear1"
            android:layout_width="match_parent"
            android:layout_height="580dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="35dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingHorizontal="15dp"
            android:paddingVertical="20dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/newrecordHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="New Record"
                android:textAlignment="center"
                android:textColor="@color/blue"
                android:textSize="22sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/record_amount"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/orange_border_bg"
                android:drawableLeft="@drawable/currency"
                android:drawablePadding="10dp"
                android:drawableTint="@color/orange"
                android:hint="Amount"
                android:inputType="number"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:singleLine="true"
                android:textColor="@color/blue"
                android:textColorHint="@color/main_bg"
                android:textStyle="bold"></EditText>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:drawableLeft="@drawable/income_expense_icon"
                android:drawablePadding="5dp"
                android:drawableTint="@color/orange"
                android:paddingLeft="20dp"
                android:text="Type Of Record :"
                android:textColor="@color/blue"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/newRecord_Radiogroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:background="@drawable/orange_border_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp">

                <RadioButton
                    android:id="@+id/icome_radiobutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/blue"
                    android:checked="true"
                    android:text="Income"
                    android:textColor="@color/green"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/expense_radiobutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:buttonTint="@color/blue"
                    android:text="Expense"
                    android:textColor="@color/red"
                    android:textStyle="bold" />
            </RadioGroup>

            <EditText
                android:id="@+id/record_desc"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/orange_border_bg"
                android:drawableStart="@drawable/description"
                android:drawablePadding="10dp"
                android:drawableTint="@color/orange"
                android:gravity="top"
                android:hint="Short Description"
                android:inputType="text|textMultiLine"
                android:maxLength="80"
                android:paddingHorizontal="20dp"
                android:paddingVertical="5dp"
                android:textColor="@color/blue"
                android:textColorHint="@color/main_bg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_weight="2"
                    android:drawableLeft="@drawable/baseline_category_24"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/orange"
                    android:paddingLeft="20dp"
                    android:text="Select Category :"
                    android:textColor="@color/blue"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:drawableLeft="@drawable/add"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/orange"
                    android:paddingLeft="20dp"
                    android:text="Add"
                    android:textColor="@color/blue"
                    android:textStyle="bold" />
            </LinearLayout>

            <Spinner
                android:id="@+id/record_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="1dp"
                android:background="@color/white"
                android:padding="2dp"
                android:spinnerMode="dropdown" />

            <EditText
                android:id="@+id/record_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/orange_border_bg"
                android:drawableLeft="@drawable/baseline_date_range_24"
                android:drawablePadding="10dp"
                android:drawableTint="@color/orange"
                android:hint="Date"
                android:inputType="date"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:textColor="@color/blue"
                android:textColorHint="@color/main_bg"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/record_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/orange_border_bg"
                android:drawableLeft="@drawable/clock"
                android:drawablePadding="10dp"
                android:drawableTint="@color/orange"
                android:hint="Time"
                android:focusable="false"
                android:inputType="date"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:textColor="@color/blue"
                android:textColorHint="@color/main_bg"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="40dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/save_record_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="7dp"
                    android:layout_weight="1"
                    android:background="@color/orange"
                    android:text="Save" />

                <Button
                    android:id="@+id/cancel_record_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="7dp"
                    android:layout_weight="1"
                    android:background="@color/gray"
                    android:text="Back" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-30dp"
        android:background="@color/blue"
        app:itemIconTint="@color/orange"
        app:itemTextColor="@color/white"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cv"
        app:layout_constraintVertical_bias="1.0"
        app:layout_wrapBehaviorInParent="skipped"
        app:menu="@menu/bottom_menu" />


</androidx.constraintlayout.widget.ConstraintLayout>