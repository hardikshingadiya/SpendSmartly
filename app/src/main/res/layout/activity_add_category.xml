<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Add_Category"
    android:background="@color/main_bg">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="516dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="546dp"
        android:padding="20dp"
        android:background="@drawable/orange_border_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/linear1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@color/white"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="15dp"
            android:paddingVertical="40dp"
            >

            <TextView
                android:id="@+id/new_cat_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add New Category"
                android:textSize="22sp"
                android:textColor="@color/blue"
                android:textStyle="bold"
                android:layout_marginBottom="30dp"
                android:textAlignment="center"/>

            <EditText
                android:id="@+id/add_cat_name"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginTop="20dp"
                android:background="@drawable/orange_border_bg"
                android:hint="New Category Name"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:singleLine="true"
                android:maxLength="35"
                android:textColor="@color/blue"
                android:textColorHint="@color/main_bg"
                android:textStyle="bold"></EditText>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category Type :"
                android:textColor="@color/blue"
                android:layout_marginTop="20dp"
                android:textStyle="bold"/>
            <RadioGroup
                android:id="@+id/add_cat_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/orange_border_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp">

                <RadioButton
                    android:id="@+id/income_newCatType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/blue"
                    android:checked="true"
                    android:text="Income"
                    android:textStyle="bold"
                    android:textColor="@color/green" />

                <RadioButton
                    android:id="@+id/expense_newCatType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:buttonTint="@color/blue"
                    android:text="Expense"
                    android:textStyle="bold"
                    android:textColor="@color/red" />
            </RadioGroup>


            <EditText
                android:id="@+id/add_cat_desc"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/orange_border_bg"
                android:gravity="top"
                android:hint="New Category Description"
                android:inputType="text|textMultiLine"
                android:maxLength="70"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:textColor="@color/blue"
                android:textColorHint="@color/main_bg"
                android:textStyle="bold"></EditText>

            <Button
                android:id="@+id/add_cat_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Add Category"
                android:textStyle="bold"
                android:background="@color/orange"/>

            <Button
                android:id="@+id/cancel_cat_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Back"
                android:textStyle="bold"
                android:background="@color/gray"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-30dp"
        android:background="@color/blue"
        app:itemIconTint="@color/orange"
        app:itemTextColor="@color/white"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:menu="@menu/bottom_menu" />
</androidx.constraintlayout.widget.ConstraintLayout>